      "ReadyResponse": { "description": "Service readiness", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadyResponse" } } } },
      "NamespaceResponse": { "description": "Namespace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Namespace" } } } },
      "TaskResponse": { "description": "Task", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } },
      "TaskEventResponse": { "description": "Task event", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskEvent" } } } },
      "ScheduleResponse": { "description": "Schedule", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Schedule" } } } },
      "WorkflowResponse": { "description": "Workflow execution", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowExecution" } } } },
      "WorkflowHistoryEventResponse": { "description": "Workflow history event", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowHistoryEvent" } } } },
      "SandboxResponse": { "description": "Sandbox", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sandbox" } } } },
      "ErrorResponse": { "description": "Request failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
