          "payload": { "$ref": "#/components/schemas/JsonValue" },
          "lease_timeout_seconds": { "type": "integer", "minimum": 0 }
        }
      },
      "Task": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "namespace", "queue", "type", "state", "attempt", "lease_timeout_seconds", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "state": { "$ref": "#/components/schemas/TaskState" },
          "namespace": { "type": "string" },
          "queue": { "type": "string" },
          "attempt": { "type": "integer", "minimum": 0 },
          "lease_timeout_seconds": { "type": "integer", "minimum": 0 },
          "payload": { "$ref": "#/components/schemas/JsonValue" },
          "result": { "$ref": "#/components/schemas/JsonValue" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TaskEventInput": { "type": "object", "additionalProperties": true, "required": ["kind"], "properties": { "kind": { "type": "string" } } },
      "TaskEvent": { "type": "object", "additionalProperties": true, "required": ["id", "task_id", "kind", "created_at"], "properties": { "id": { "type": "string" }, "task_id": { "type": "string" }, "kind": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" } } },
      "Schedule": { "type": "object", "additionalProperties": true, "required": ["id", "namespace", "state", "spec", "action", "next_run_at", "created_at", "updated_at"] },
      "CreateScheduleRequest": { "type": "object", "additionalProperties": true, "required": ["spec", "action"] },
      "UpdateScheduleRequest": { "type": "object", "additionalProperties": true },
      "PauseScheduleRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "UnpauseScheduleRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "TriggerScheduleRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "TriggerScheduleResponse": { "type": "object", "additionalProperties": true, "required": ["schedule", "task"] },
      "BackfillScheduleRequest": { "type": "object", "additionalProperties": false, "required": ["start_at", "end_at"], "properties": { "start_at": { "type": "string", "format": "date-time" }, "end_at": { "type": "string", "format": "date-time" } } },
      "BackfillScheduleResponse": { "type": "object", "additionalProperties": true, "required": ["schedule", "tasks"] },
      "WorkflowExecution": { "type": "object", "additionalProperties": true, "required": ["id", "run_id", "namespace", "type", "queue", "task_id", "state", "created_at", "updated_at"] },
      "WorkflowHistoryEvent": { "type": "object", "additionalProperties": true, "required": ["id", "workflow_id", "type", "created_at"] },
      "WorkflowCountResponse": { "type": "object", "additionalProperties": false, "required": ["count"], "properties": { "count": { "type": "integer", "minimum": 0 } } },
      "SignalWorkflowRequest": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" }, "args": { "type": "array", "items": { "$ref": "#/components/schemas/JsonValue" } } } },
      "SignalWithStartWorkflowRequest": { "type": "object", "additionalProperties": true, "required": ["workflowType", "signal"], "properties": { "workflowType": { "type": "string" }, "signal": { "$ref": "#/components/schemas/SignalWorkflowRequest" } } },
      "SignalWithStartWorkflowResponse": { "type": "object", "additionalProperties": false, "required": ["workflow", "task", "signal"], "properties": { "workflow": { "$ref": "#/components/schemas/WorkflowExecution" }, "task": { "$ref": "#/components/schemas/Task" }, "signal": { "$ref": "#/components/schemas/WorkflowHistoryEvent" } } },
      "CancelWorkflowRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "TerminateWorkflowRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "PollTaskResponse": { "type": "object", "additionalProperties": true, "properties": { "task": { "$ref": "#/components/schemas/Task" } } },
      "HeartbeatTaskRequest": { "type": "object", "additionalProperties": false, "properties": { "lease_timeout_seconds": { "type": "integer", "minimum": 0 }, "event": { "$ref": "#/components/schemas/TaskEventInput" } } },
      "AppendTaskEventRequest": { "type": "object", "additionalProperties": false, "required": ["event"], "properties": { "event": { "$ref": "#/components/schemas/TaskEventInput" } } },
      "CompleteTaskRequest": { "type": "object", "additionalProperties": false, "required": ["result"], "properties": { "result": { "$ref": "#/components/schemas/JsonValue" } } },
      "BlockTaskRequest": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
      "FailTaskRequest": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "string" }, "result": { "$ref": "#/components/schemas/JsonValue" } } },
      "RefreshAgentSessionRequest": { "type": "object", "additionalProperties": false, "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } },
      "AgentSessionResponse": { "type": "object", "additionalProperties": true, "required": ["agentId", "tenantId", "tokenFamilyId", "accessToken", "refreshToken", "accessExpiresAt", "refreshExpiresAt", "status", "trustState"] },
      "Sandbox": { "type": "object", "additionalProperties": true, "required": ["tenantId", "id", "name", "createdBy", "desiredState", "observedState", "generation", "observedGeneration", "backend", "isolationClass", "image", "resourceLimits", "networkPolicy", "createdAt", "updatedAt"] },
      "SandboxCreateRequest": { "type": "object", "additionalProperties": true, "required": ["name", "image"] },
      "SandboxListResponse": { "type": "object", "additionalProperties": false, "required": ["sandboxes"], "properties": { "sandboxes": { "type": "array", "items": { "$ref": "#/components/schemas/Sandbox" } } } },
      "CreateSandboxSessionRequest": { "type": "object", "additionalProperties": true },
      "CreateSandboxSessionResponse": { "type": "object", "additionalProperties": true, "required": ["id", "ticket", "expiresAt"] },
      "SandboxWorkspace": { "type": "object", "additionalProperties": true, "required": ["tenantId", "id", "sha256", "sizeBytes", "repositoryName", "createdBy", "createdAt", "expiresAt"] },
      "ErrorResponse": { "type": "object", "additionalProperties": true, "required": ["error"], "properties": { "error": { "type": "string" }, "code": { "type": "string" } } }
    }
  }
}
